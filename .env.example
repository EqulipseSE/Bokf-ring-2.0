# Anslutningssträng till PostgreSQL (lokalt eller Neon).
# Neon: kopiera "Connection string" från projektets dashboard.
DATABASE_URL=postgresql://bokforing:bokforing@localhost:5432/bokforing

# Gratis nycklar från Bolagsverkets kundanmälan för värdefulla datamängder.
# test använder sandbox (accept2). production använder det skarpa registret.
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
BOLAGSVERKET_ENV=test

# Enable Banking sandbox. APP_ID är appens id i kontrollpanelen.
# Redirect-adressen måste vara vitlistad på samma app.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_PATH=data/enable-banking.pem
ENABLE_BANKING_REDIRECT_URL=http://localhost:3000/bank/callback
